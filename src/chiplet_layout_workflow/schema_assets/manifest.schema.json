{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "$comment": "Draft 2020-12 cannot compare run_id with parent_run_id; self-parent and other dynamic lineage rules are enforced by runtime semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "checksums": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "source_commit": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "config_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "metric_schema_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "result_checksums": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "executor": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model_provider": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"type": "string", "enum": ["pending", "approved", "rejected", "superseded", "failed"]},
    "research_target": {"$ref": "#/$defs/research_target"},
    "human_gates_enabled": {"type": "boolean", "default": true},
    "parent_run_id": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
    "target_transition_action": {"type": ["string", "null"], "enum": ["no_change", "revise_run", "supersede_run", null]}
  },
  "required": ["run_id", "checksums", "source_commit", "config_checksum", "metric_schema_checksum", "executor", "model_provider", "status", "research_target"],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {"properties": {"research_target": {"allOf": [{"required": ["approved", "approval_receipt"]}, {"properties": {"approved": {"const": true}}}]}}}
    },
    {
      "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
      "then": {"required": ["parent_run_id", "target_transition_action"], "properties": {"parent_run_id": {"type": "string"}, "target_transition_action": {"const": "supersede_run"}}}
    },
    {
      "if": {"properties": {"parent_run_id": {"type": "string"}}, "required": ["parent_run_id"]},
      "then": {"required": ["target_transition_action"], "properties": {"target_transition_action": {"const": "supersede_run"}}}
    },
    {
      "if": {"properties": {"target_transition_action": {"const": "supersede_run"}}, "required": ["target_transition_action"]},
      "then": {"required": ["parent_run_id"], "properties": {"parent_run_id": {"type": "string"}}}
    }
  ],
  "$defs": {
    "research_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "target_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "display_name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "revision": {"type": "integer", "minimum": 0},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "approved": {"type": "boolean"},
        "approval_receipt": {"anyOf": [{"$ref": "#/$defs/approval_receipt"}, {"type": "null"}]}
      },
      "required": ["display_name", "revision", "source", "evidence_checksum", "approved"],
      "anyOf": [{"required": ["id"]}, {"required": ["target_id"]}],
      "not": {"required": ["id", "target_id"]},
      "allOf": [
        {
          "if": {"properties": {"approved": {"const": true}}, "required": ["approved"]},
          "then": {"required": ["approval_receipt"], "properties": {"approval_receipt": {"$ref": "#/$defs/approval_receipt"}}}
        },
        {
          "if": {"properties": {"approved": {"const": false}}, "required": ["approved"]},
          "then": {"properties": {"approval_receipt": {"type": "null"}}}
        }
      ]
    },
    "target_proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "display_name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "approved": {"type": "boolean"},
        "requires_human_approval": {"const": true},
        "approval_state": {"enum": ["pending", "approved"]}
      },
      "required": ["id", "display_name", "source", "evidence_checksum", "approved", "requires_human_approval", "approval_state"],
      "allOf": [
        {"if": {"properties": {"approved": {"const": true}}, "required": ["approved"]}, "then": {"properties": {"approval_state": {"const": "approved"}}}},
        {"if": {"properties": {"approved": {"const": false}}, "required": ["approved"]}, "then": {"properties": {"approval_state": {"const": "pending"}}}}
      ]
    },
    "target_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "approved": {"const": true},
        "evidence_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "decision": {"const": "approve"},
        "proposal": {"$ref": "#/$defs/target_proposal"}
      },
      "required": ["id", "approved", "evidence_checksum", "source", "decision", "proposal"]
    },
    "approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_version": {"const": 1},
        "proposal": {"$ref": "#/$defs/target_proposal"},
        "decision": {"$ref": "#/$defs/target_decision"}
      },
      "required": ["receipt_version", "proposal", "decision"]
    }
  }
}
