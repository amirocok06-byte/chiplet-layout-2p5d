{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunConfig",
  "$comment": "Draft 2020-12 validates receipt structure only; equality between outer research_target metadata and approval_receipt.proposal is enforced by runtime semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "data_root": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
    "obsidian": {"anyOf": [{"$ref": "#/$defs/obsidian"}, {"type": "null"}]},
    "zotero": {"$ref": "#/$defs/zotero"},
    "web_retrieval": {"$ref": "#/$defs/web_retrieval"},
    "execution": {"$ref": "#/$defs/execution"},
    "human_gates": {"$ref": "#/$defs/human_gates"},
    "upload": {"$ref": "#/$defs/upload"},
    "research_target": {"$ref": "#/$defs/research_target"},
    "parent_run_id": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"}
  },
  "required": ["topic", "data_root", "research_target"],
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "title": {"type": ["string", "null"]}
      },
      "required": ["path"]
    },
    "obsidian": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vault": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "include": {"type": "array", "items": {"type": "string"}},
        "write_back": {"type": "boolean"}
      },
      "required": ["vault"]
    },
    "zotero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "web_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "allowed_domains": {"type": "array", "items": {"type": "string"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["local", "ssh"]},
        "command_allowlist": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "human_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_policy": {"type": "string", "enum": ["allow", "deny"]},
        "allowed_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "research_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "target_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "display_name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "revision": {"type": "integer", "minimum": 0},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "approved": {"type": "boolean"},
        "approval_receipt": {"anyOf": [{"$ref": "#/$defs/approval_receipt"}, {"type": "null"}]}
      },
      "required": ["display_name", "revision", "source", "evidence_checksum", "approved"],
      "anyOf": [{"required": ["id"]}, {"required": ["target_id"]}],
      "not": {"required": ["id", "target_id"]},
      "allOf": [
        {
          "if": {"properties": {"approved": {"const": true}}, "required": ["approved"]},
          "then": {"required": ["approval_receipt"], "properties": {"approval_receipt": {"$ref": "#/$defs/approval_receipt"}}}
        },
        {
          "if": {"properties": {"approved": {"const": false}}, "required": ["approved"]},
          "then": {"properties": {"approval_receipt": {"type": "null"}}}
        }
      ]
    },
    "target_proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "display_name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "approved": {"type": "boolean"},
        "requires_human_approval": {"const": true},
        "approval_state": {"enum": ["pending", "approved"]}
      },
      "required": ["id", "display_name", "source", "evidence_checksum", "approved", "requires_human_approval", "approval_state"],
      "allOf": [
        {"if": {"properties": {"approved": {"const": true}}, "required": ["approved"]}, "then": {"properties": {"approval_state": {"const": "approved"}}}},
        {"if": {"properties": {"approved": {"const": false}}, "required": ["approved"]}, "then": {"properties": {"approval_state": {"const": "pending"}}}}
      ]
    },
    "target_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "approved": {"const": true},
        "evidence_checksum": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "decision": {"const": "approve"},
        "proposal": {"$ref": "#/$defs/target_proposal"}
      },
      "required": ["id", "approved", "evidence_checksum", "source", "decision", "proposal"]
    },
    "approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_version": {"const": 1},
        "proposal": {"$ref": "#/$defs/target_proposal"},
        "decision": {"$ref": "#/$defs/target_decision"}
      },
      "required": ["receipt_version", "proposal", "decision"]
    }
  }
}
